# Studio — Vercel environment template
#
# Import this file into the project's environment variables, then replace every
# <placeholder>. Vercel accepts dotenv format:
#
#     Project → Settings → Environment Variables → Import .env
#
# or per-variable from the CLI:
#
#     vercel env add STUDIO_ENCRYPTION_KEY production
#
# Generate the two secrets (32 bytes each; the crypto module accepts a 64-character
# hex string or a 44-character base64 string):
#
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# Two of these settings have no safe default on this platform, and the app will not
# start without them:
#
#   * STUDIO_DATABASE_URL — a serverless filesystem is discarded between
#     invocations, so SQLite cannot hold the queue or the library. Use Postgres
#     (Neon, Supabase, Vercel Postgres, RDS).
#   * STUDIO_ENCRYPTION_KEY — provider API keys are sealed with it. Lose it and
#     every stored credential is unreadable; there is no recovery path, so back it
#     up somewhere outside Vercel before the first generation.
#
# STUDIO_AUTH_SECRET is the same kind of value for a different job: session
# digests, CSRF tokens and IP hashing. Rotating it signs everybody out.
#
# Local development does not want this file: use `.env.example` instead, which
# leaves the defaults (SQLite, local object store, mock provider) in place.

# ---------------------------------------------------------------------------
# Runtime identity
# ---------------------------------------------------------------------------

# development | test | production. On a deployment this must be production: it
# turns off the development defaults — the mock provider, plain-http endpoints,
# loopback egress, and a non-Secure session cookie.
STUDIO_ENV=production

# The public origin, used as the CSRF allowlist and the redirect base. A wrong
# value means every state-changing request is refused with `forbidden`, because
# the Origin header no longer matches.
STUDIO_PUBLIC_APP_URL=<https://your-project.vercel.app>

# The API root the client calls. Same host, `/api` on the end.
STUDIO_API_BASE_URL=<https://your-project.vercel.app/api>

# Refuses a session cookie that did not arrive over https, and adds HSTS.
STUDIO_REQUIRE_HTTPS=true

# Vercel terminates TLS at its edge, so the app must read the forwarded headers
# to see the real scheme and client address.
STUDIO_TRUST_PROXY_HEADERS=true

# ---------------------------------------------------------------------------
# Secrets — required. Generate both; never reuse one for the other.
# ---------------------------------------------------------------------------

STUDIO_ENCRYPTION_KEY=<replace-with-secrets-token-hex-32>
STUDIO_AUTH_SECRET=<replace-with-secrets-token-hex-32>

# ---------------------------------------------------------------------------
# Database — required. Postgres connection string, TLS on.
# ---------------------------------------------------------------------------

# Shape: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# The value is a credential: add it with `vercel env add`, not in a commit.
STUDIO_DATABASE_URL=<postgres-connection-string-with-sslmode-require>

# Only /tmp is writable on a serverless filesystem. The directory is created at
# startup for the key-file fallback and the local object store; neither is used
# once the two settings above are in place, but the mkdir still happens.
STUDIO_DATA_DIR=/tmp/studio

# ---------------------------------------------------------------------------
# Object storage — required on serverless. Generated images and videos must outlive
# the invocation that produced them, so the local disk backend cannot be used.
# Any S3-compatible store works: S3, Cloudflare R2, Backblaze B2, MinIO, Supabase
# Storage's S3 endpoint.
# ---------------------------------------------------------------------------

STUDIO_STORAGE_BACKEND=s3
STUDIO_STORAGE_ENDPOINT=<https://s3-endpoint-for-your-provider>
STUDIO_STORAGE_REGION=us-east-1
STUDIO_STORAGE_BUCKET=<bucket-name>
STUDIO_STORAGE_ACCESS_KEY=<access-key-id>
STUDIO_STORAGE_SECRET_KEY=<secret-access-key>

# Path-style addressing: required by MinIO and most S3-compatible services, and
# harmless on AWS.
STUDIO_STORAGE_FORCE_PATH_STYLE=true

# How long a presigned download link stays valid.
STUDIO_STORAGE_URL_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Workers — zero on serverless, on purpose.
# ---------------------------------------------------------------------------

# A function invocation may be frozen or discarded the moment it answers, so a
# polling thread started here would be killed mid-job. Generation is advanced by
# the cron tick in vercel.json (`/api/studio_cron`), and by every read of a job
# that is still running.
STUDIO_JOB_WORKERS=0

# ---------------------------------------------------------------------------
# Safety switches — the production answers, stated so they are a decision and not
# a default inherited by accident.
# ---------------------------------------------------------------------------

# With the placeholder provider on, a user can generate an image, receive it, and
# believe it is real. It is labelled everywhere, and it is still off by default.
STUDIO_ENABLE_MOCK_PROVIDER=false

# An API key sent over plain http is an API key handed to the network.
STUDIO_ALLOW_INSECURE_ENDPOINTS=false

# Empty in production: the egress policy blocks private and link-local addresses,
# and this list is the only way to add exceptions. Leave it blank unless you
# deliberately reach a self-hosted inference server over a private network.
STUDIO_ALLOW_PRIVATE_HOSTS=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

STUDIO_LOG_LEVEL=info

# One JSON object per line, which is what Vercel's log viewer is built for.
STUDIO_LOG_JSON=true

# ---------------------------------------------------------------------------
# Limits and timeouts — sensible production values; adjust, do not delete.
# ---------------------------------------------------------------------------

# Requests per minute per client, and the stricter budget for the routes that
# touch a credential.
STUDIO_RATE_LIMIT_PER_MINUTE=120
STUDIO_CREDENTIAL_RATE_LIMIT_PER_MINUTE=20

# Session lifetime in seconds (14 days).
STUDIO_SESSION_TTL_SECONDS=1209600

# Minimum password length for an account on this deployment.
STUDIO_PASSWORD_MIN_LENGTH=12

# Upload ceilings: 25 MB for an image or reference frame, 200 MB for a video.
STUDIO_MAX_UPLOAD_BYTES=26214400
STUDIO_MAX_VIDEO_UPLOAD_BYTES=209715200

# How long a claimed job may go without a heartbeat before another worker may take
# it, and how many times one job may be attempted.
STUDIO_JOB_LEASE_SECONDS=300
STUDIO_JOB_MAX_ATTEMPTS=3

# Seconds between provider polls, and the wall-clock ceiling for one job.
STUDIO_JOB_POLL_INTERVAL=5
STUDIO_JOB_PROVIDER_TIMEOUT=900
STUDIO_JOB_RETRY_BACKOFF=30

# The egress client: how long it may spend connecting, reading, following
# redirects, and how much it may bring back.
STUDIO_EGRESS_CONNECT_TIMEOUT=10
STUDIO_EGRESS_READ_TIMEOUT=120
STUDIO_EGRESS_MAX_REDIRECTS=3
STUDIO_EGRESS_MAX_RESPONSE_BYTES=26214400
STUDIO_EGRESS_MAX_DOWNLOAD_BYTES=209715200
