{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/compile.py": {
      "memory": 512,
      "maxDuration": 60,
      "excludeFiles": "{**/__pycache__/**,**/test_*.py,.env*,.pytest_cache/**,.studio_env.sh,dev.py,docs/**,prompt-studio.env,promptlayer/vendor/**,requirements-dev.txt,scripts/**,studio/**,tests/**,var/**,web/dist/**,web/node_modules/**}"
    },
    "api/studio_cron.py": {
      "memory": 1024,
      "maxDuration": 60,
      "excludeFiles": "{**/__pycache__/**,**/test_*.py,.env*,.pytest_cache/**,.studio_env.sh,dev.py,docs/**,prompt-studio.env,promptlayer/**,promptlayer/*.py,promptlayer/vendor/**,requirements-dev.txt,scripts/**,tests/**,var/**,web/node_modules/**}"
    },
    "api/studio.py": {
      "memory": 1024,
      "maxDuration": 60,
      "excludeFiles": "{**/__pycache__/**,**/test_*.py,.env*,.pytest_cache/**,.studio_env.sh,dev.py,docs/**,prompt-studio.env,promptlayer/vendor/**,requirements-dev.txt,scripts/**,tests/**,var/**,web/node_modules/**}"
    },
    "api/*.py": {
      "memory": 512,
      "maxDuration": 15,
      "excludeFiles": "{**/__pycache__/**,**/test_*.py,.env*,.pytest_cache/**,.studio_env.sh,dev.py,docs/**,prompt-studio.env,promptlayer/vendor/**,requirements-dev.txt,scripts/**,studio/**,tests/**,var/**,web/dist/**,web/node_modules/**}"
    }
  },
  "rewrites": [
    {
      "source": "/studio/(.*)",
      "destination": "/api/studio"
    },
    {
      "source": "/api/studio/(.*)",
      "destination": "/api/studio"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/studio"
    }
  ],
  "crons": [
    {
      "path": "/api/studio_cron",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
