# Studio Platform - environment template
#
# Every variable studio/config.py reads is listed here. Copy this file to .env
# (or export the values in your shell) and replace the placeholders.
#
# Rules this file follows:
#   * Nothing here is required to BOOT. An unconfigured install starts, reports
#     what is missing through Configuration.missing_for(), and simply cannot
#     generate or store credentials until the gaps are filled.
#   * Every secret below is an obvious placeholder. Never commit a real key.
#   * The environment prefix is STUDIO_. A variable with any other prefix is
#     not read by studio/config.py at all.

# ---------------------------------------------------------------------------
# Runtime identity and where data lives
# ---------------------------------------------------------------------------

# development | test | production. Default: development.
# Missing: defaults to development, which enables the mock provider and the
# loopback egress allowance below. Insecure endpoints stay off either way.
STUDIO_ENV=development

# NOTE: this variable is NOT read. studio/config.py reads STUDIO_ENV above.
# It is only listed for completeness: setting it has no effect.
# STUDIO_ENVIRONMENT=production

# Root for the SQLite database, generated key files and (by default) objects.
# Default: ./var/studio relative to the process working directory.
# Missing: the default is created at startup with mkdir(parents=True).
STUDIO_DATA_DIR=./var/studio

# Absolute base URL of the browser app. Used for the CSRF origin allowlist.
# Default: http://127.0.0.1:8090
# Missing: the default is used, so a deployment on a real hostname rejects
# same-origin POSTs until this is set.
STUDIO_PUBLIC_APP_URL=http://127.0.0.1:8090

# Absolute base URL of the API, also used for the origin allowlist.
# Default: http://127.0.0.1:8090/api
# Missing: the default is used.
STUDIO_API_BASE_URL=http://127.0.0.1:8090/api

# critical | error | warning | warn | info | debug. Default: info.
# Missing: info.
STUDIO_LOG_LEVEL=info

# true renders one JSON object per log line, false a compact key=value line.
# Default: true when STUDIO_ENV=production, otherwise false.
# Missing: follows the environment default.
STUDIO_LOG_JSON=false

# ---------------------------------------------------------------------------
# Database (SQLite)
# ---------------------------------------------------------------------------

# The database. Leave empty for SQLite at STUDIO_DATABASE_PATH (the default,
# and the only backend that needs no service). Set it to a postgresql:// URL to
# use Postgres instead -- Supabase, RDS, or a local server.
#
#   Postgres:  STUDIO_DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
#   SQLite:    STUDIO_DATABASE_URL=
#
# The same seven migrations apply to either engine; there is no second schema
# to keep in step. Two Postgres notes:
#   * use the POOLER host and port (Supabase: :6543). Studio holds a small
#     connection pool (12 max); a direct connection string works but wastes
#     server connections.
#   * the role needs to CREATE TABLE on first boot, then only normal DML.
#     Studio enforces workspace scoping in the service layer, not with RLS, so
#     the role must be allowed to read across workspaces.
# Missing: empty string, and the SQLite path below is used.
STUDIO_DATABASE_URL=

# SQLite file. Ignored when STUDIO_DATABASE_URL is set.
# Default: <STUDIO_DATA_DIR>/studio.db
# Missing: the default path is used and the parent directory is created.
STUDIO_DATABASE_PATH=./var/studio/studio.db

# Milliseconds a write waits for the write lock before SQLITE_BUSY.
# Default: 5000. Missing: 5000.
STUDIO_DB_BUSY_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------

# local | s3. Default: local.
# Missing: local, which needs no further configuration and is the only backend
# that has been exercised.
STUDIO_STORAGE_BACKEND=local

# Root directory for the local backend. Default: <STUDIO_DATA_DIR>/objects
# Missing: the default is used.
STUDIO_STORAGE_ROOT=./var/studio/objects

# S3-compatible endpoint, e.g. https://s3.eu-west-1.amazonaws.com
# The S3 backend is selected only when endpoint, bucket, access key AND secret
# key are all non-empty (see store_from_config in studio/storage.py).
# Missing: the local backend is used.
STUDIO_STORAGE_ENDPOINT=

# Bucket name. Missing: the local backend is used.
STUDIO_STORAGE_BUCKET=

# Region used in the SigV4 credential scope. Default: us-east-1.
# Missing: us-east-1.
STUDIO_STORAGE_REGION=us-east-1

# Access key id for the bucket. Missing: the local backend is used.
STUDIO_STORAGE_ACCESS_KEY=

# Secret access key for the bucket. Missing: the local backend is used.
STUDIO_STORAGE_SECRET_KEY=

# Lifetime of a presigned GET URL, in seconds. Default: 900.
# Missing: 900.
STUDIO_STORAGE_URL_TTL_SECONDS=900

# true addresses the bucket as /bucket/key, which most S3-compatible servers
# (MinIO, R2) require. Default: true. Missing: true.
STUDIO_STORAGE_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Secrets (set these in every real deployment)
# ---------------------------------------------------------------------------

# AES-256-GCM key used to seal provider API keys. Accepts 64 hex characters,
# 44 base64 characters, or any other string (which is stretched with scrypt).
# Missing: a random key is generated once and written to
# <STUDIO_DATA_DIR>/.studio-encryption-key with mode 0600, and
# Configuration.generated_keys becomes true. Credentials sealed under that
# file become unreadable if the data directory is lost.
STUDIO_ENCRYPTION_KEY=replace-me-with-32-bytes-of-hex

# HMAC key for session-token digests, CSRF tokens and IP hashing.
# Missing: generated once into <STUDIO_DATA_DIR>/.studio-auth-secret. Every
# existing session stops working if that file is replaced.
STUDIO_AUTH_SECRET=replace-me-with-32-bytes-of-hex

# Session lifetime in seconds. Default: 1209600 (14 days). Missing: 14 days.
STUDIO_SESSION_TTL_SECONDS=1209600

# Minimum password length. Default: 10. Missing: 10.
STUDIO_PASSWORD_MIN_LENGTH=10

# true refuses a session cookie that was not delivered over https.
# Default: true when STUDIO_ENV=production, otherwise false.
# Missing: follows the environment default.
STUDIO_REQUIRE_HTTPS=false

# true trusts X-Forwarded-For for the client address, which matters for rate
# limiting behind a proxy. Default: true. Missing: true.
STUDIO_TRUST_PROXY_HEADERS=true

# Per-address request budget per minute for ordinary routes.
# Default: 600. Missing: 600.
STUDIO_RATE_LIMIT_PER_MINUTE=600

# Per-address budget per minute for routes whose path contains /auth/ or
# /connections. Default: 30. Missing: 30.
STUDIO_CREDENTIAL_RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------------------
# Outbound request policy (SSRF guard in studio/net.py)
# ---------------------------------------------------------------------------

# true allows plain http:// endpoints. Default: false in EVERY environment,
# production included. An API key sent over http is readable by anything on the
# network path, and a laptop in a coffee shop is not a safer place than a
# server. Set this only for a lab, or for a provider on your own loopback.
STUDIO_ALLOW_INSECURE_ENDPOINTS=false

# Comma-separated hostnames allowed to resolve to private, loopback or
# link-local addresses - the deliberate door for a self-hosted inference
# server. Default: empty in production; localhost,127.0.0.1,::1 when
# STUDIO_ENV is not production. Missing: follows the environment default.
STUDIO_ALLOW_PRIVATE_HOSTS=localhost,127.0.0.1,::1

# Connect timeout in seconds. Default: 10.0. Missing: 10.0.
STUDIO_EGRESS_CONNECT_TIMEOUT=10

# Read timeout in seconds. Default: 60.0. Missing: 60.0.
STUDIO_EGRESS_READ_TIMEOUT=60

# Largest provider response body parsed, in bytes. Default: 8388608.
# Missing: 8 MiB.
STUDIO_EGRESS_MAX_RESPONSE_BYTES=8388608

# Largest generated artefact downloaded, in bytes. Default: 536870912.
# Missing: 512 MiB.
STUDIO_EGRESS_MAX_DOWNLOAD_BYTES=536870912

# Redirect hops followed, each re-validated. Default: 3. Missing: 3.
STUDIO_EGRESS_MAX_REDIRECTS=3

# ---------------------------------------------------------------------------
# Job queue and worker
# ---------------------------------------------------------------------------

# Worker threads in the process. Default: 2. Missing: 2.
STUDIO_JOB_WORKERS=2

# Seconds between queue polls. Default: 1.0. Missing: 1.0.
STUDIO_JOB_POLL_INTERVAL=1

# Seconds a provider may stay "processing" before the job times out.
# Default: 1800. Missing: 1800.
STUDIO_JOB_PROVIDER_TIMEOUT=1800

# Attempts before a job is terminally failed. Default: 3. Missing: 3.
STUDIO_JOB_MAX_ATTEMPTS=3

# Base of the exponential retry backoff, in seconds. Default: 5.0.
# Missing: 5.0.
STUDIO_JOB_RETRY_BACKOFF=5

# Seconds a worker's claim on a job is honoured before another may take it.
# Default: 120. Missing: 120.
STUDIO_JOB_LEASE_SECONDS=120

# ---------------------------------------------------------------------------
# Uploads and media
# ---------------------------------------------------------------------------

# Largest accepted upload, in bytes. Default: 26214400 (25 MiB).
# Missing: 25 MiB. The API contract rejects a larger body with
# validation_failed.
STUDIO_MAX_UPLOAD_BYTES=26214400

# Largest accepted video upload, in bytes. Default: 536870912 (512 MiB).
# Missing: 512 MiB.
STUDIO_MAX_VIDEO_UPLOAD_BYTES=536870912

# Longest edge of a generated thumbnail, in pixels. Default: 512.
# Missing: 512. Requires Pillow at runtime; without it no thumbnail is made.
STUDIO_THUMBNAIL_MAX_PIXELS=512

# ---------------------------------------------------------------------------
# Development provider (never real output)
# ---------------------------------------------------------------------------

# true registers the local mock adapter, which renders a placeholder file from
# the request seed and labels it as a placeholder on the model, the job and the
# asset. Default: true when STUDIO_ENV is not production, otherwise false.
# Missing: follows the environment default. Turn it off in production.
STUDIO_ENABLE_MOCK_PROVIDER=true

# ---------------------------------------------------------------------------
# Deploying Studio to Vercel
# ---------------------------------------------------------------------------
# Studio's routes are served by one function mounted at /api/studio, because
# /api/health, /api/models and /api/presets already belong to the Prompt Layer
# functions in this repository. Nothing here needs setting to run locally.
#
# Required for a serverless deployment, in addition to the values above:
#
#   STUDIO_DATABASE_URL        Postgres. A serverless filesystem is discarded
#                              between invocations, so SQLite cannot work.
#   STUDIO_STORAGE_BACKEND=s3  A serverless filesystem cannot hold uploaded or
#                              generated files either. Asking for s3 without
#                              the four settings below is a hard error rather
#                              than a silent fall back to disk.
#   CRON_SECRET                Guards /api/studio_cron, which is how generation
#                              work runs with no worker threads. Unset means the
#                              endpoint refuses everything -- the URL is public,
#                              and an open queue is other people spending your
#                              provider credit.
#
# Optional:
#
#   VITE_STUDIO_API_PREFIX=/api/studio   Build-time only. The client prefixes
#                                        every route path with this. Set it when
#                                        building the React client for Vercel:
#                                          VITE_STUDIO_API_PREFIX=/api/studio npm run build
#                                        Leave unset for same-origin serving.
#   STUDIO_TICK_LIMIT=3                  Jobs per cron invocation.
#   STUDIO_TICK_BUDGET=45                Seconds a tick may spend before it
#                                        stops claiming more work.

# ---------------------------------------------------------------------------
# Names that are NOT read
# ---------------------------------------------------------------------------
# Lists these on purpose, because they look plausible and setting them does
# nothing. studio/config.py reads only the names above.
#
#   STUDIO_ENVIRONMENT          -> STUDIO_ENV is the real name
#   STUDIO_ALLOW_INSECURE       -> STUDIO_ALLOW_INSECURE_ENDPOINTS
#   STUDIO_JOBS_*               -> STUDIO_JOB_* (singular)
#   STUDIO_MEDIA_*              -> STUDIO_MAX_UPLOAD_BYTES,
#                                  STUDIO_MAX_VIDEO_UPLOAD_BYTES,
#                                  STUDIO_THUMBNAIL_MAX_PIXELS
#   STUDIO_MOCK_PROVIDER_ENABLED-> STUDIO_ENABLE_MOCK_PROVIDER

